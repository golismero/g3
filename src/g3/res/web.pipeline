# Web pentest pipeline.
# Currently rather barren, since most g3 plugins are for network scanning.
# Hopefully that will change soon.

# Run tests against every URL in scope.
shcheck
untangle
wafw00f
testssl
nikto

# Run the same tests against any discovered subdomains too.
# This implicitly adds them to the pentest scope!
subfinder | shcheck
subfinder | untangle
subfinder | wafw00f
subfinder | testssl
subfinder | nikto
