{
    url: "https://github.com/MarioVilas/shcheck",
    description: "A basic tool to check security headers of a website. Forked from: https://github.com/santoru/shcheck",
    commands: [
        {
            condition: "{{if and .url (or (eq .scheme \"http\") (eq .scheme \"https\"))}} true {{else}} false {{end}}",
            command: ["{{.url}}"],
            fingerprint: ["shcheck.py {{.url}}"],
            returns: "url",
        },
    ],
}