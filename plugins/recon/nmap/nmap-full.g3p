// This version of the plugin does the most thorough possible scan.
// It may also take a long time to run!
{
    description: {
        en: "Nmap is a free and open source utility for network discovery and security auditing."
    },
    url: "https://nmap.org/",
    image: "ghcr.io/golismero/nmap",
    llm: {
        summary: "Network scanner — full sweep (all 65535 ports, OS+version+default scripts; slow but exhaustive).",
        accepts: ["host"],
        produces: "host",
        commands: [
            { description: "Full IPv4 scan: all ports, OS detection, version probes, default scripts. Slow." },
            { description: "Full IPv6 scan: all ports, OS detection, version probes, default scripts (requires G3_ENV_IPV6_SUPPORTED). Slow." },
        ],
    },
    commands: [
        {
            condition: "{{if .services}} false {{else}} {{if .ipv4}} true {{else}} false {{end}} {{end}}",
            fingerprint: ["nmap {{.ipv4}}"],
            command: ["-A", "-O", "-p-", "-Pn", "-vvv", "--", "{{.ipv4}}"],
            dockeropt: ["-i", "--rm", "--cap-add", "NET_ADMIN"],
            returns: "host",
        },

        // You'll need to enable IPv6 on Docker and on your host for this to work:
        // https://docs.docker.com/config/daemon/ipv6/
        {
            condition: "{{if .services}} false {{else}} {{if and .ipv6 (eq (env).G3_ENV_IPV6_SUPPORTED \"true\")}} true {{else}} false {{end}} {{end}}",
            fingerprint: ["nmap {{.ipv6}}"],
            command: ["-6", "-A", "-O", "-p-", "-Pn", "-vvv", "--", "{{.ipv6}}"],
            dockeropt: ["-i", "--rm", "--cap-add", "NET_ADMIN"],
            returns: "host",
        },
    ],
}