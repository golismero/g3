// This version of the plugin does the fastest possible scan.
// It will not be very thorough.
{
    description: "Nmap is a free and open source utility for network discovery and security auditing.",
    url: "https://nmap.org/",
    image: "ghcr.io/golismero/nmap",
    commands: [
        {
            condition: "{{if .services}} false {{else}} {{if .ipv4}} true {{else}} false {{end}} {{end}}",
            fingerprint: ["nmap {{.ipv4}}"],
            command: ["-sT", "-O", "-vvv", "--", "{{.ipv4}}"],
            dockeropt: ["-i", "--rm", "--cap-add", "NET_ADMIN"],
            returns: "host",
        },
        {
            condition: "{{if .services}} false {{else}} {{if and .ipv6 (eq (env).G3_ENV_IPV6_SUPPORTED \"true\")}} true {{else}} false {{end}} {{end}}",
            fingerprint: ["nmap {{.ipv6}}"],
            command: ["-6", "-sT", "-O", "-vvv", "--", "{{.ipv6}}"],
            dockeropt: ["-i", "--rm", "--cap-add", "NET_ADMIN"],
            returns: "host",
        },
    ],
}