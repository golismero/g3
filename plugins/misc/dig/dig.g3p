{
    url: "https://www.cyberciti.biz/faq/linux-unix-dig-command-examples-usage-syntax/",
    description: "The dig command in Linux is used to gather DNS information. It stands for Domain Information Groper, and it collects data about Domain Name Servers.",

    // For all inputs run multiple commands, each for every DNS record type we're interested in.
    // Sometimes querying for all records does not work, depending on the domain and DNS server.
    // Only run against objects that do not have any discovered DNS records (prevents data reentry).
    commands: [
        {
            condition: |||
                {{if .dnsrecords}}
                    false
                {{else}}
                    {{if .domain}}
                        true
                    {{else}}
                        false
                    {{end}}
                {{end}}
            |||,
            fingerprint: ["dig -t A {{.domain}}"],
            command: ["dig", "-t", "A", "{{.domain}}", "@8.8.8.8"],
        },
        {
            condition: |||
                {{if not (eq (env).G3_ENV_IPV6_SUPPORTED "true")}}
                    false
                {{else}}
                    {{if .dnsrecords}}
                        false
                    {{else}}
                        {{if .domain}}
                            true
                        {{else}}
                            false
                        {{end}}
                    {{end}}
                {{end}}
            |||,
            fingerprint: ["dig -t AAAA {{.domain}}"],
            command: ["dig", "-t", "AAAA", "{{.domain}}", "@8.8.8.8"],
        },
        {
            condition: |||
                {{if .dnsrecords}}
                    false
                {{else}}
                    {{if .domain}}
                        true
                    {{else}}
                        false
                    {{end}}
                {{end}}
            |||,
            fingerprint: ["dig -t any {{.domain}}"],
            command: ["dig", "-t", "any", "{{.domain}}", "@8.8.8.8"],
        },

        // Special case: reverse DNS queries.
        {
            condition: |||
                {{if .dnsrecords}}
                    false
                {{else}}
                    {{if .ipv4}}
                        true
                    {{else}}
                        false
                    {{end}}
                {{end}}
            |||,
            fingerprint: ["dig -x {{.ipv4}}"],
            command: ["dig", "-x", "{{.ipv4}}", "@8.8.8.8"],
        },
        {
            condition: |||
                {{if not (eq (env).G3_ENV_IPV6_SUPPORTED "true")}}
                    false
                {{else}}
                    {{if .dnsrecords}}
                        false
                    {{else}}
                        {{if .ipv6}}
                            true
                        {{else}}
                            false
                        {{end}}
                    {{end}}
                {{end}}
            |||,
            fingerprint: ["dig -x {{.ipv6}}"],
            command: ["dig", "-x", "{{.ipv6}}", "@8.8.8.8"],
        },
    ],

    importer: {},
}