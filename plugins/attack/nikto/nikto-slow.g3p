{
    url: "https://github.com/sullo/nikto",
    description: "Nikto is a free software command-line vulnerability scanner that scans webservers for dangerous files/CGIs, outdated server software and other problems.",
    image: "ghcr.io/golismero/nikto",

    commands: [

        // Run against http:// urls.
        {
            condition: "{{if and .url (eq .scheme \"http\")}} true {{else}} false {{end}}",
            fingerprint: ["nikto {{.host}}"],
            command: ["-Pause", "1", "-host", "{{.host}}"],
            returns: "nil",
        },

        // Run against https:// urls.
        {
            condition: "{{if and .url (eq .scheme \"https\")}} true {{else}} false {{end}}",
            fingerprint: ["nikto {{.host}}"],
            command: ["-Pause", "1", "-ssl", "-host", "{{.host}}"],
            returns: "nil",
        },

    ],
}