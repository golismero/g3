{
    url: "https://github.com/vanhauser-thc/thc-hydra",
    description: {
        en: "Hydra is a parallelized login cracker which supports numerous protocols to attack. It is very fast and flexible, and new modules are easy to add."
    },

    llm: {
        summary: "Parallelized network login cracker.",
        accepts: ["host"],
        produces: "issue",
        commands: [
            { description: "Brute-force logins on an IPv4 host's discovered services." },
            { description: "Brute-force logins on an IPv6 host's discovered services (requires G3_ENV_IPV6_SUPPORTED)." },
        ],
    },

    commands: [

        // Run against host objects that have discovered services.
        {
            condition: "{{if and .ipv4 .services}} true {{else}} false {{end}}",
            fingerprint: ["hydra {{.ipv4}}"],
            returns: "issue",
            dockeropt: ["-i", "--rm", "-e", "HYDRA_LOGIN_FILE", "-e", "HYDRA_PASSWORD_FILE", "-e", "HYDRA_MAX_TASKS"],
        },
        {
            condition: "{{if and .ipv6 .services (eq (env).G3_ENV_IPV6_SUPPORTED \"true\")}} true {{else}} false {{end}}",
            fingerprint: ["hydra {{.ipv6}}"],
            returns: "issue",
            dockeropt: ["-i", "--rm", "-e", "HYDRA_LOGIN_FILE", "-e", "HYDRA_PASSWORD_FILE", "-e", "HYDRA_MAX_TASKS"],
        },
    ],

    importer: {
        returns: "issue",
    },

    merger: {},
}