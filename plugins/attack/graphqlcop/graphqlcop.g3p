{
    url: "https://github.com/dolevf/graphql-cop",
    description: "GraphQL Cop is a small Python utility to run common security tests against GraphQL APIs.",
    image: "ghcr.io/golismero/graphqlcop",
    commands: [
        {
            condition: "{{if and .url (or (eq .scheme \"http\") (eq .scheme \"https\"))}} true {{else}} false {{end}}",
            fingerprint: ["graphqlcop {{.url}}"],
            command: ["{{.url}}"],
        },
    ],
    importer: {},
}
