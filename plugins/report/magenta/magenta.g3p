{
    url: "https://github.com/golismero/magenta",
    description: "Magenta Reporter takes the output files from commonly used penetration testing tools and generates a ready to use report in Markdown format.",
    reporter: {
        default: "MarkDown",
        commands: [
            {name: "MarkDown", command: ["-f", "markdown", "-o", "/output/report.md"]},
            {name: "Obsidian", command: ["-f", "obsidian", "-o", "/output/"]},
            {name: "Textile", command: ["-f", "textile", "-o", "/output/report.textile"]},
            {name: "Dradis", command: ["-f", "dradis", "-o", "/output/dradis.textile"]},
            {name: "JSON", command: ["-f", "json", "-o", "/output/report.json"]},
        ],
    },
}